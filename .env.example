# Kullanılacak model kaynağı: "pretrained" (hazır MegaDescriptor) veya "finetuned" (yerel checkpoint)
MODEL_SOURCE=pretrained

# MODEL_SOURCE=finetuned ise kullanılacak checkpoint yolu
MODEL_CHECKPOINT=models/best_model.pth

# timm model adı (hf-hub üzerinden indirilir)
MODEL_NAME=hf-hub:BVRA/MegaDescriptor-S-224

# Yerel arama indeksinin diskteki yolu
INDEX_PATH=outputs/embeddings/pet_index.npz

# API'nin izin verdiği CORS origin'leri (virgülle ayrılmış, * tüm origin'lere izin verir)
CORS_ORIGINS=*

# Kabul edilen maksimum yüklenen dosya boyutu (byte)
MAX_UPLOAD_SIZE_BYTES=10485760
